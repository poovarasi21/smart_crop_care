<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Stitch Card Styles -->
    <style name="Widget.SmartCropCare.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface_container_lowest</item>
        <item name="cardElevation">1dp</item>
    </style>

    <!-- Stitch Interactive Buttons -->
    <style name="Widget.SmartCropCare.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.SmartCropCare.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/secondary_container</item>
        <item name="android:textColor">@color/on_secondary_container</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.SmartCropCare.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
