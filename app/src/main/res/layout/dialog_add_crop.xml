<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_container_lowest"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_neutral" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:text="@string/add_crop_title"
        android:textColor="@color/primary"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif"
        android:text="@string/add_crop_subtitle"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp" />

    <!-- Crop Name Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCropName"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/add_crop_name_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCropName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Variety Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCropVariety"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/add_crop_variety_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCropVariety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Plot Name & Acreage Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPlotName"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:hint="@string/add_crop_plot_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPlotName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAcreage"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:hint="@string/add_crop_acreage_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAcreage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="1.0" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Soil Type Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSoilType"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/add_crop_soil_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSoilType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Red Sandy Loam Soil (pH 6.8)" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveCrop"
        style="@style/Widget.SmartCropCare.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="@string/add_crop_save_button" />

</LinearLayout>
