<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/diseaseToolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:contentInsetStart="12dp"
            app:contentInsetEnd="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnBackDisease"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/disease_detection_title"
                        android:textColor="@color/primary"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/ai_model_version"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnInfoDialog"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/outline" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content Canvas -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="40dp">

            <!-- Field Capture Protocol Instruction Banner -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmartCropCare.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_rounded_container_low"
                        android:padding="8dp"
                        android:src="@drawable/ic_agriculture"
                        app:tint="@color/primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/field_capture_protocol_title"
                            android:textColor="@color/primary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif"
                            android:lineSpacingMultiplier="1.1"
                            android:text="@string/field_capture_protocol_desc"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Target Crop Category Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/target_crop_category"
                    android:textAllCaps="true"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="4 Models Calibrated"
                    android:textColor="@color/secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCrops"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTomato"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Tomato"
                        app:chipBackgroundColor="@color/secondary_container"
                        app:chipStrokeColor="@color/secondary"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipOkra"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ladies Finger / Okra" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBrinjal"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brinjal / Eggplant" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipChilli"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chilli" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Viewfinder Scanner Viewport -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmartCropCare.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Camera Viewport Box with Framing Corners & Lesion Box -->
                    <FrameLayout
                        android:id="@+id/viewfinderContainer"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:background="@color/surface_container_highest">

                        <!-- Leaf Preview Image -->
                        <ImageView
                            android:id="@+id/ivLeafPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/tomato_leaf_blight" />

                        <!-- Animated Laser Line -->
                        <View
                            android:id="@+id/viewLaserLine"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:background="@drawable/bg_laser_line" />

                        <!-- Corner Guides -->
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|start"
                            android:layout_margin="8dp"
                            android:src="@drawable/corner_tl" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="8dp"
                            android:src="@drawable/corner_tr" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="bottom|start"
                            android:layout_margin="8dp"
                            android:src="@drawable/corner_bl" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="8dp"
                            android:src="@drawable/corner_br" />

                        <!-- Bounding Box Annotation on Lesion -->
                        <LinearLayout
                            android:id="@+id/lesionBoundingBox"
                            android:layout_width="120dp"
                            android:layout_height="110dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_pill_warning"
                            android:backgroundTint="#26D97706"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <TextView
                                android:id="@+id/tvLesionTag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_warning"
                                android:fontFamily="sans-serif-bold"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:text="Lesion #1"
                                android:textColor="@color/on_tertiary_fixed"
                                android:textSize="9sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvLesionConfidence"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:background="@drawable/bg_pill_optimal"
                                android:fontFamily="sans-serif-bold"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:text="92.4% Conf."
                                android:textColor="@color/primary"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <!-- Top Status Badge -->
                        <TextView
                            android:id="@+id/tvScanStateBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_pill_white"
                            android:fontFamily="sans-serif-bold"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="Analysis Complete"
                            android:textColor="@color/primary"
                            android:textSize="10sp" />
                    </FrameLayout>

                    <!-- Camera Control Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTakePhoto"
                            style="@style/Widget.SmartCropCare.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="@string/btn_take_photo"
                            app:icon="@drawable/ic_photo_camera" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUploadGallery"
                            style="@style/Widget.SmartCropCare.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="@string/btn_upload_gallery"
                            app:icon="@drawable/ic_photo_library" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Instant AI Diagnosis Result Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmartCropCare.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header Diagnosis Alert -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_pill_warning"
                            android:padding="8dp"
                            android:src="@drawable/ic_warning" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/pathology_identified"
                                android:textAllCaps="true"
                                android:textColor="@color/tertiary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvDiseaseName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/early_blight_title"
                                android:textColor="@color/on_surface"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tvDiseasePathogen"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/early_blight_subtitle"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_optimal"
                            android:fontFamily="sans-serif-bold"
                            android:text="Verified"
                            android:textColor="@color/on_secondary_container"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Confidence & Severity Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <!-- Confidence Meter -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_rounded_container_low"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/confidence_meter"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvConfidenceText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="92% Match"
                                android:textColor="@color/primary"
                                android:textSize="15sp" />

                            <ProgressBar
                                android:id="@+id/pbConfidence"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:max="100"
                                android:progress="92"
                                android:progressTint="@color/primary" />
                        </LinearLayout>

                        <!-- Severity Level -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_rounded_container_low"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/severity_level"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvSeverityStage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="@string/stage_1_mild"
                                android:textColor="@color/tertiary"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Initial lesions on canopy"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Observed Symptoms Block -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_rounded_container_low"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/observed_symptoms"
                            android:textColor="@color/primary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvSymptomsList"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingMultiplier="1.2"
                            android:text="• Concentric dark brown rings: Classic 'target board' pattern\n• Chlorotic margins: Slight yellow halo spreading around lesion"
                            android:textColor="@color/on_surface"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Recommended Treatment Options (Dual Path) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/recommended_treatment"
                        android:textColor="@color/primary"
                        android:textSize="14sp" />

                    <!-- Organic Path -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_rounded_container_low"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/cultural_organic_mgmt"
                            android:textColor="@color/secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvOrganicTreatment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingMultiplier="1.1"
                            android:text="Prune infected lower leaves and discard away from field. Avoid overhead sprinkler watering to reduce leaf wetness duration."
                            android:textColor="@color/on_surface"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Chemical Spray Path -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_rounded_container_low"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/targeted_chemical_spray"
                            android:textColor="@color/tertiary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvChemicalTreatment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingMultiplier="1.1"
                            android:text="Apply Mancozeb 75% WP @ 2g/litre of water or Copper Oxychloride 50% WP @ 2.5g/litre during calm morning hours."
                            android:textColor="@color/on_surface"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Disclaimer -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/disclaimer_icar"
                        android:textColor="@color/outline"
                        android:textSize="10sp" />

                    <!-- Workflow Action Buttons -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveMedicalHistory"
                        style="@style/Widget.SmartCropCare.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/btn_save_medical_history" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShareKvk"
                        style="@style/Widget.SmartCropCare.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_share_kvk" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
